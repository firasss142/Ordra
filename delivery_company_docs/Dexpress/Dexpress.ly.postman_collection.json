  "item": [
    {
      "name": "GET Login Page",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Extract the CSRF _token from the login page HTML and save it\r",
              "const html = pm.response.text();\r",
              "const match = html.match(/name=\"_token\"\\s+value=\"([^\"]+)\"/);\r",
              "if (match) {\r",
              "    pm.collectionVariables.set(\"csrf_token\", match[1]);\r",
              "    console.log(\"Saved CSRF token:\", match[1].substring(0, 12) + \"...\");\r",
              "} else {\r",
              "    console.error(\"Could not find _token in login page!\");\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "response": []
    },
